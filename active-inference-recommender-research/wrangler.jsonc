{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "active-inference-recommender",
  "main": "app/main.py",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./app/static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
