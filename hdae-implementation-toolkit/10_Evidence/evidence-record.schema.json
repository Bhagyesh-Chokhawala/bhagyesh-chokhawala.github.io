{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HDAE Evidence Record",
  "type": "object",
  "required": [
    "evidence_id",
    "timestamp",
    "event_type",
    "agent_id",
    "intent_id",
    "correlation_id",
    "record_hash"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "intent_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "represented_principal": {
      "type": "string"
    },
    "authority_decision": {
      "type": "object"
    },
    "policy_decision": {
      "type": "object"
    },
    "action": {
      "type": "object"
    },
    "result": {
      "type": "object"
    },
    "previous_hash": {
      "type": "string"
    },
    "record_hash": {
      "type": "string"
    }
  }
}